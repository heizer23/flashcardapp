<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Spinner to choose filter (Past, Future, All) -->
    <Spinner
        android:id="@+id/spinner_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="8dp" />

    <!-- Button to go back to topics -->
    <Button
        android:id="@+id/btn_go_topics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to Topics"
        android:layout_gravity="center_horizontal"
        android:padding="8dp" />

    <!-- Headers for the columns -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="?android:attr/windowBackground">

        <TextView
            android:id="@+id/tv_header_question"
            android:text="Question"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_answer"
            android:text="Answer"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_time"
            android:text="Time Diff"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_interval"
            android:text="Interval"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RecyclerView for displaying flashcards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_flashcards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
