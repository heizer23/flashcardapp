<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- RecyclerView to display topics with checkboxes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_topics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Button to toggle all selections -->
    <Button
        android:id="@+id/btn_toggle_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle All" />

    <!-- Save button to confirm selection -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Selection" />

</LinearLayout>
